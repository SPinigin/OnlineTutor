@model OnlineTutor.Models.ViewModels.TestModuleIndexViewModel

@{
    ViewData["Title"] = "Управление тестами";
}

<div class="container">
    <div class="section-header mb-4">
        <h2><i class="fas fa-tasks"></i> Управление тестами</h2>
        <p class="text-muted">Выберите тип теста для работы с ним</p>
    </div>

    <div class="row">

        <div class="col-md-6 mb-4">
            <div class="card test-type-card h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-spell-check me-2"></i>
                        Тесты правописания
                    </h5>
                </div>
                <div class="card-body d-flex flex-column">
                    <p class="card-text">
                        Создавайте тесты на проверку правописания. Студенты должны вставить правильные буквы в слова с пропусками.
                    </p>
                    <div class="mt-auto">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <small class="text-muted">Создано тестов: @Model.SpellingTestsCount</small>
                        </div>
                        <div class="d-grid gap-2">
                            <a asp-action="Spelling" class="btn btn-primary">
                                <i class="fas fa-list me-2"></i>Управление тестами
                            </a>
                            <a asp-action="CreateSpelling" class="btn btn-outline-primary">
                                <i class="fas fa-plus me-2"></i>Создать новый
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="col-md-6 mb-4">
            <div class="card test-type-card h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-question-circle me-2"></i>
                        Обычные тесты
                    </h5>
                </div>
                <div class="card-body d-flex flex-column">
                    <p class="card-text">
                        Создавайте тесты с различными типами вопросов: выбор одного или нескольких ответов, короткие и развернутые ответы.
                    </p>
                    <div class="mt-auto">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <small class="text-muted">Создано тестов: @Model.RegularTestsCount</small>
                        </div>
                        <div class="d-grid gap-2">
                            <a asp-action="Regular" class="btn btn-success">
                                <i class="fas fa-list me-2"></i>Управление тестами
                            </a>
                            <a asp-action="CreateRegular" class="btn btn-outline-success">
                                <i class="fas fa-plus me-2"></i>Создать новый
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="col-md-6 mb-4">
            <div class="card test-type-card h-100 border-dashed">
                <div class="card-header bg-light text-muted">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-plus-circle me-2"></i>
                        Новые типы тестов
                    </h5>
                </div>
                <div class="card-body d-flex flex-column">
                    <p class="card-text text-muted">
                        Здесь будут добавлены новые типы тестов: математические, по литературе, истории и другие.
                    </p>
                    <div class="mt-auto">
                        <button class="btn btn-outline-secondary" disabled>
                            <i class="fas fa-clock me-2"></i>Скоро доступно
                        </button>
                    </div>
                </div>
            </div>
        </div>


        <div class="col-md-6 mb-4">
            <div class="card test-type-card h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-chart-bar me-2"></i>
                        Общая статистика
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6">
                            <h3 class="text-primary">@Model.TotalTestsCount</h3>
                            <small class="text-muted">Всего тестов</small>
                        </div>
                        <div class="col-6">
                            <h3 class="text-success">@Model.SpellingTestsCount</h3>
                            <small class="text-muted">Правописание</small>
                        </div>
                    </div>
                    <hr>
                    <div class="d-grid">
                        <a href="#" class="btn btn-info">
                            <i class="fas fa-analytics me-2"></i>Подробная статистика
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .test-type-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        border: 1px solid #dee2e6;
    }

    .test-type-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .border-dashed {
        border-style: dashed !important;
        border-color: #dee2e6 !important;
    }

    .section-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .section-header h2 {
        margin-bottom: 0.5rem;
    }
</style>
